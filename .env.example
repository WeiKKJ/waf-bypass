# 目标发票 URL（必填）
# 下面是一个示例地址，请替换成你自己的真实发票 URL
#
# ⚠️ 这个文件已在 .gitignore 中排除，真实发票 URL 不会进入版本库。
# ⚠️ 更重要的是：**不要**把它写进 Dockerfile 的 ENV / build args ——
#    ENV 会固化进镜像 config，推到 Docker Hub 后任何人 docker inspect 都能读到。
#    TARGET_URL 一律在运行时传入（docker run -e / compose environment）。
TARGET_URL=https://dppt.qingdao.chinatax.gov.cn:8443/kpfw/fpjfzz/v1/exportDzfpwjEwm?Wjgs=PDF&Jym=CF96&Fphm=12345678901234567890&Czsj=1792633512001&Kprq=20260727160553

# 可选：挑战 JS 的等待时间（毫秒）
# 目标站点 JS 较重时可适当调大
WAF_WAIT_MS=14000

# 可选：浏览器采集超时（秒）
WAF_HEAL_TIMEOUT=120
